# Integration test config — copy to .env.test (or set in your shell) and fill in.
#
# Path A (live test project, default): point at the same project as .env but use
# the SERVICE_ROLE key (not the anon key) so tests can seed and cleanup their own
# fixtures. The integration-setup helper falls back to VITE_SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY from the main .env if these specific test vars are
# unset, so for local dev you can just rely on the main .env.
#
# Path B (supabase start local stack): requires Docker, which is not running on
# Andrew's machine — see supabase/CLAUDE.md. If you do have Docker:
#   VITE_SUPABASE_TEST_URL=http://localhost:54321
#   SUPABASE_TEST_SERVICE_ROLE_KEY=<local stack service role>

VITE_SUPABASE_TEST_URL=
SUPABASE_TEST_SERVICE_ROLE_KEY=

# Required for RLS regression test (Phase 38, src/test/rls-regression.test.ts).
# The test signs in real users via signInWithPassword against the test
# project. CI sets this from secrets; local devs only need it when running
# rls-regression.test.ts directly. Falls back to VITE_SUPABASE_PUBLISHABLE_KEY
# in the main .env if unset.
VITE_SUPABASE_TEST_ANON_KEY=
