{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.sentry.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://fathom.video https://zoom.us https://marketplace.zoom.us"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/webhook",
      "destination": "https://vltmrnjsubfzrgrtdqey.supabase.co/functions/v1/webhook",
      "has": [
        {
          "type": "host",
          "value": "^app\\.callvaultai\\.com$"
        }
      ]
    },
    {
      "source": "/api/zoom-webhook",
      "destination": "https://vltmrnjsubfzrgrtdqey.supabase.co/functions/v1/zoom-webhook",
      "has": [
        {
          "type": "host",
          "value": "^app\\.callvaultai\\.com$"
        }
      ]
    },
    {
      "source": "/api/fireflies-webhook/:path*",
      "destination": "https://vltmrnjsubfzrgrtdqey.supabase.co/functions/v1/fireflies-webhook/:path*",
      "has": [
        {
          "type": "host",
          "value": "^app\\.callvaultai\\.com$"
        }
      ]
    },
    {
      "source": "/api/read-ai-webhook/:path*",
      "destination": "https://vltmrnjsubfzrgrtdqey.supabase.co/functions/v1/read-ai-webhook/:path*",
      "has": [
        {
          "type": "host",
          "value": "^app\\.callvaultai\\.com$"
        }
      ]
    },
    {
      "source": "/api/grain-webhook/:path*",
      "destination": "https://vltmrnjsubfzrgrtdqey.supabase.co/functions/v1/grain-webhook/:path*",
      "has": [
        {
          "type": "host",
          "value": "^app\\.callvaultai\\.com$"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
