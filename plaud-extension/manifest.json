{
  "manifest_version": 3,
  "name": "CallVault Plaud Connector",
  "description": "Lets CallVault request a Plaud bearer token from the user's active Plaud Web session.",
  "version": "0.1.0",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "CallVault Plaud Connector",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "permissions": [
    "scripting",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "https://app.callvaultai.com/*",
    "https://test.callvaultai.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://web.plaud.ai/*",
    "https://api.plaud.ai/*",
    "https://api-euc1.plaud.ai/*",
    "https://api-apse1.plaud.ai/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.callvaultai.com/*",
        "https://test.callvaultai.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "src/callvault-content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://web.plaud.ai/*"
      ],
      "js": [
        "src/credential-utils.js",
        "src/plaud-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/callvault-bridge.png",
        "src/page-bridge.js"
      ],
      "matches": [
        "https://app.callvaultai.com/*",
        "https://test.callvaultai.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    },
    {
      "resources": [
        "assets/callvault-bridge.png"
      ],
      "matches": [
        "https://web.plaud.ai/*"
      ]
    }
  ]
}
